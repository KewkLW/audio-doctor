#!/usr/bin/env python3
"""footprint NAME [--secs 30] | footprint compare A B
System footprint snapshot for before/after comparisons (e.g. no DAW vs DAW loaded with tracks inactive).
Measures over a window: whole-machine CPU busy, per-process CPU (top 15), memory (used, available,
swap), process/thread counts, load average, package temperature, average core clock, PipeWire graph
(driver quantum, per-node busy/quantum, ERR). Saves ~/.local/state/omarchy-studio/footprint/NAME.json."""
import glob, json, os, re, subprocess as sp, sys, time

DIR = os.path.expanduser("~/.local/state/omarchy-studio/footprint")


def rd(p, d=""):
    try: return open(p).read().strip()
    except OSError: return d


def proc_times():
    out = {}
    for p in os.listdir("/proc"):
        if not p.isdigit(): continue
        st = rd(f"/proc/{p}/stat")
        if not st: continue
        r = st.rsplit(")", 1)
        f = r[1].split()
        out[int(p)] = (int(f[11]) + int(f[12]), r[0].split("(", 1)[1])
    return out


def meminfo():
    m = {l.split(":")[0]: int(l.split()[1]) for l in rd("/proc/meminfo").splitlines()}
    return {"total_gb": round(m["MemTotal"] / 2**20, 2), "used_gb": round((m["MemTotal"] - m["MemAvailable"]) / 2**20, 2),
            "available_gb": round(m["MemAvailable"] / 2**20, 2), "swap_used_gb": round((m["SwapTotal"] - m["SwapFree"]) / 2**20, 2)}


RME_OFF = "no RME ADI-2: module off"
RME_ON = False  # set in snap() from modules/rme-adi2/detect


def rme_present():
    """RME module contract: RME rows only when modules/rme-adi2/detect says the ADI-2 is on USB (standby = absent).
    The checkout's module (one level up from audit/), else the installed kit copy. No module = off."""
    here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    for d in (os.path.join(here, "modules", "rme-adi2", "detect"),
              os.path.join(data, "audio-doctor", "modules", "rme-adi2", "detect")):
        if os.access(d, os.X_OK):
            try: return sp.run([d], capture_output=True, timeout=5).returncode == 0
            except (OSError, sp.TimeoutExpired): return False
    return False


def rme_node(name):
    """An ADI-2 ALSA node or one of the rme-adi2 module's loopback nodes (rme_phones, rme_in, ...)."""
    return "RME_ADI" in name or any(t in ("rme_phones", "rme_phones.out", "rme_in", "rme_in.cap") for t in name.split())


def pw_top():
    out = sp.run(["pw-top", "-b", "-n", "3"], capture_output=True, text=True, timeout=15).stdout.splitlines()
    rows, hdr = {}, None
    for line in out:
        if line.startswith("S ") and "NAME" in line:
            hdr = (line.index("FORMAT"), line.index("NAME")); continue
        if not hdr or len(line) < hdr[1]: continue
        h = line[:hdr[0]].split()
        if len(h) < 9 or not h[1].isdigit(): continue
        rows[line[hdr[1]:].strip()] = {"state": h[0], "quant": h[2], "wait": h[4], "busy": h[5], "w/q": h[6], "b/q": h[7], "err": h[8]}
    return {n: r for n, r in rows.items() if r["state"] == "R" and (RME_ON or not rme_node(n))}


DAW_RE = re.compile(r"bitwig|reaper|ardour|zrythm|carla|qtractor|renoise|lmms|bespoke|ableton|live\.exe|fl64\.exe|studio one|cubase", re.I)


def pkg_temp():
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        if rd(f"{z}/type") == "x86_pkg_temp":
            v = rd(f"{z}/temp")
            if v.isdigit(): return int(v) / 1000
    for h in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        if rd(f"{h}/name") in ("k10temp", "zenpower", "coretemp"):
            v = rd(f"{h}/temp1_input")
            if v.isdigit(): return int(v) / 1000
    return None


def daw_running():
    for p in os.listdir("/proc"):
        if not p.isdigit(): continue
        comm = rd(f"/proc/{p}/comm")
        if comm and (DAW_RE.search(comm) or comm in ("BitwigAudioEngi", "BitwigStudio")):
            return True
    return False


def snap(name, secs):
    global RME_ON
    RME_ON = rme_present()
    if not RME_ON: print(RME_OFF, flush=True)  # the one neutral line: no ADI-2 node is metered or listed
    hz = os.sysconf("SC_CLK_TCK")
    s0, p0 = [int(x) for x in rd("/proc/stat").splitlines()[0].split()[1:]], proc_times()
    temps, mhz = [], []
    t_end = time.time() + secs
    while time.time() < t_end:
        t = pkg_temp()
        if t is not None: temps.append(t)
        f = [int(rd(c)) for c in glob.glob("/sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq") if rd(c).isdigit()]
        if f: mhz.append(sum(f) / len(f) / 1000)
        time.sleep(1)
    s1, p1 = [int(x) for x in rd("/proc/stat").splitlines()[0].split()[1:]], proc_times()
    d = [b - a for a, b in zip(s0, s1)]
    per = {}
    for pid, (t, comm) in p1.items():
        dt = t - p0.get(pid, (t, comm))[0]
        if dt > 0:
            per.setdefault(comm, 0); per[comm] += dt / hz / secs * 100
    top = sorted(per.items(), key=lambda x: -x[1])[:15]
    nthreads = sum(int(m[1]) for p in os.listdir("/proc") if p.isdigit() for m in [re.search(r"Threads:\s+(\d+)", rd(f"/proc/{p}/status"))] if m)
    daw = daw_running()
    js = {"name": name, "time": time.strftime("%F %T"), "secs": secs,
          "cpu_busy_pct": round(100 * (1 - (d[3] + d[4]) / max(sum(d), 1)), 2),
          "top_cpu_pct_of_one_core": [(c, round(v, 2)) for c, v in top],
          "memory": meminfo(), "processes": len([p for p in os.listdir("/proc") if p.isdigit()]), "threads": nthreads,
          "loadavg": rd("/proc/loadavg").split()[:3],
          "pkg_temp_c": {"min": min(temps), "avg": round(sum(temps) / len(temps), 1), "max": max(temps)} if temps else None,
          "avg_core_mhz": round(sum(mhz) / len(mhz)) if mhz else None,
          "rme_module": "on" if RME_ON else "off",
          "pipewire_running_nodes": pw_top(),
          "pipewire_settings": dict(re.findall(r"key:'(clock\.[^']+)' value:'([^']*)'", sp.run(["pw-metadata", "-n", "settings", "0"], capture_output=True, text=True).stdout)),
          "daw_running": daw,
          "bitwig_running": bool(sp.run(["pgrep", "-f", "^/opt/bitwig-studio/bin/Bitwig"], capture_output=True).stdout.strip())}
    os.makedirs(DIR, exist_ok=True)
    json.dump(js, open(f"{DIR}/{name}.json", "w"), indent=1)
    m = js["memory"]
    print(f"footprint '{name}' ({secs} s, {js['time']}): CPU busy {js['cpu_busy_pct']}% of all threads, "
          f"memory used {m['used_gb']} / {m['total_gb']} GB (swap {m['swap_used_gb']} GB), {js['processes']} processes / {nthreads} threads, "
          f"load {' '.join(js['loadavg'])}, package {js['pkg_temp_c']}°C, avg clock {js['avg_core_mhz']} MHz, DAW running: {js['daw_running']}")
    print("  top CPU (% of one core): " + ", ".join(f"{c} {v}" for c, v in top[:8]))
    print("  PipeWire running nodes: " + (", ".join(f"{n[:40]} q{r['quant']} b/q {r['b/q']}" for n, r in js["pipewire_running_nodes"].items()) or "none (graph idle)"))


def compare(a, b):
    A, B = (json.load(open(f"{DIR}/{x}.json")) for x in (a, b))
    def row(label, f):
        va, vb = f(A), f(B)
        try: delta = f"{vb - va:+.2f}"
        except TypeError: delta = ""
        print(f"  {label:34} {str(va):>14} {str(vb):>14} {delta:>10}")
    print(f"  {'':34} {a:>14} {b:>14} {'change':>10}")
    row("CPU busy, % of all threads", lambda j: j["cpu_busy_pct"])
    row("memory used, GB", lambda j: j["memory"]["used_gb"])
    row("swap used, GB", lambda j: j["memory"]["swap_used_gb"])
    row("processes", lambda j: j["processes"])
    row("threads", lambda j: j["threads"])
    row("package temp avg, °C", lambda j: (j["pkg_temp_c"] or {}).get("avg"))
    row("avg core clock, MHz", lambda j: j["avg_core_mhz"])
    print("  new top CPU in", b + ":", ", ".join(f"{c} {v}" for c, v in B["top_cpu_pct_of_one_core"] if c not in dict(A["top_cpu_pct_of_one_core"]))[:300])


USAGE = """usage: footprint NAME [--secs 30] | footprint compare A B
  -h, --help          print this and exit (no snapshot)
  NAME [--secs N]     take a system + PipeWire snapshot over N seconds (default 30)
  compare A B         show the delta between two saved snapshots
"""


if __name__ == "__main__":
    a = sys.argv[1:]
    if not a or any(x in ("-h", "--help") for x in a):
        print(USAGE, end=""); sys.exit(0)
    elif a[0] == "compare":
        if len(a) != 3:
            print("footprint: compare needs two snapshot names\n" + USAGE, end="", file=sys.stderr); sys.exit(2)
        compare(a[1], a[2])
    else:
        name = a[0]
        if name.startswith("-") or "/" in name or name in (".", ".."):
            print(f"footprint: invalid snapshot name or option: {name}\n" + USAGE, end="", file=sys.stderr); sys.exit(2)
        secs = 30
        if len(a) == 3 and a[1] == "--secs" and a[2].isdigit() and int(a[2]) > 0:
            secs = int(a[2])
        elif len(a) != 1:
            print(f"footprint: unknown arguments: {' '.join(a[1:])}\n" + USAGE, end="", file=sys.stderr); sys.exit(2)
        snap(name, secs)
