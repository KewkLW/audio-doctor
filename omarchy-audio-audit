#!/usr/bin/env python3
"""omarchy-audio-audit: measure how fit THIS machine is for realtime audio (Omarchy Studio W1c,
measured half). Meant to run on the first start of an Omarchy Studio install, after any tuning
change (before/after proof), and when troubleshooting. It reports numbers and validity flags,
not verdicts: the agent skill judges them for this system.

Per load condition (idle = the box as it is, stress = a fixed synthetic recipe):
  context    load average, package temperature, throttle-time delta, top CPU consumers
  latency    (root) turbostat; cyclictest without/with the C-state hold; rtla timerlat
             without/with the hold. Split by core class (P/E on hybrid Intel)
  buffers    PipeWire quantum sweep on the default output's interface: xruns per size,
             valid only if the interface's driver really ran at that size
Plus a system snapshot (CPU, governor/EPP, kernel, PipeWire settings, interface, USB power),
audio-doctor before and after, a JSON file and an HTML report.

  omarchy-audio-audit                 full run (~12 min; ONE sudo approval for the latency probes)
  omarchy-audio-audit --quick         short probes (~4 min), for a smoke test
  omarchy-audio-audit --no-root       skip the root latency probes (no sudo)
  omarchy-audio-audit --loads idle    only one load condition (idle,stress)
  omarchy-audio-audit --sizes 1024,128,64
  omarchy-audio-audit --daw 60        DAW phase: a JACK client (DAW) must be connected; measures
                                      xruns at the CURRENT size for 60 s per load, never changes it
  omarchy-audio-audit --first-run     write to the 'first-run' slot once (skips if it exists)
  omarchy-audio-audit --sudo keyring  unattended: sudo password from the keyring instead of ntfy
  omarchy-audio-audit --label NAME    tag the result dir
  omarchy-audio-audit --no-disk       skip the NVMe cold-read (disk wake) test
  omarchy-audio-audit --disk-path DIR where the disk wake probe file lives (default: the results folder;
                                      point it at your sample library's drive)
Power settings (read-only, always): sleep/idle, USB autosuspend per interface + its hubs and controller,
governor/EPP/turbo, C-states, PCIe ASPM (policy + per-link via root lspci), PCI runtime PM, NVIDIA power
management, HDA power save, PipeWire suspend, NVMe APST, write-back, Wi-Fi power save, Ethernet EEE,
NMI watchdog, power tuners. Each gets a verdict: keep / session (switch in session mode) / measure / change.

Safety: restores clock.force-quantum and clock.force-rate to exactly what it found, on every
exit path; refuses the buffer sweep while a JACK client (DAW) is connected (a size change kills
Bitwig's engine); never restarts PipeWire; stops its own stress-ng and silence stream by PID.
Results: ~/.local/state/omarchy-studio/audit/<time>[-label]/ (audit.json, report.html, raw/).
"""
import atexit, glob, html, json, os, re, shutil, signal, subprocess as sp, sys, time

ARGS = sys.argv[1:]
def opt(name, default=None):
    return ARGS[ARGS.index(name) + 1] if name in ARGS and ARGS.index(name) + 1 < len(ARGS) else default

# Every flag main() reads. Checked before anything runs; parsing itself stays in main() (opt / `in ARGS`).
FLAGS = ["--quick", "--no-root", "--first-run", "--no-disk"]
VALUE_FLAGS = ["--loads", "--sizes", "--daw", "--sudo", "--label", "--disk-path", "--root-helper", "--rtla", "--user"]
USAGE = """usage: omarchy-audio-audit [options]   (no options: full run, ~12 min, one sudo approval)
  -h, --help          print this and exit (no run)
  --quick             short probes (~4 min), for a smoke test
  --no-root           skip the root latency probes (no sudo)
  --loads LIST        load conditions to run, comma separated: idle,stress (default both)
  --sizes LIST        buffer sizes for the sweep, comma separated (default 1024,256,128,64,32)
  --daw SECS          DAW phase: a connected JACK client required; xruns at the CURRENT size for SECS per load
  --first-run         write to the 'first-run' slot once (skips if it exists)
  --sudo keyring      unattended: sudo password from the keyring instead of ntfy
  --label NAME        tag the result dir
  --no-disk           skip the NVMe cold-read (disk wake) test
  --disk-path DIR     where the disk wake probe file lives (default: the results folder)
  --root-helper DIR   internal: the root helper the audit starts through sudo
  --rtla PATH         internal: rtla path for the root helper
  --user NAME         internal: the invoking user, for the root helper
"""


def check_args(argv):
    """(None, None) when argv is fine, ("help", tok) for -h/--help anywhere (also where a value would go: help never
    starts a run), else ("bad", tok) for the first token that is not a known flag or a flag's value. Any other token
    right after a value flag is its value (also when it looks like a flag): that is how opt() reads it."""
    for a in argv:
        if a in ("-h", "--help"):
            return "help", a
    for i, a in enumerate(argv):
        if not (a in FLAGS or a in VALUE_FLAGS or i > 0 and argv[i - 1] in VALUE_FLAGS):
            return "bad", a
    return None, None

RME_ON = False  # set in main() from modules/rme-adi2/detect
STATE = os.path.expanduser("~/.local/state/omarchy-studio/audit")
STRESS = ["stress-ng", "--cpu", "0", "--cpu-load", "70", "--vm", "2", "--vm-bytes", "512M"]
STRESS_LABEL = "synthetic: stress-ng --cpu <all> --cpu-load 70 --vm 2 --vm-bytes 512M (about load average 22 on 32 threads, close to typical agent load; NOT real agent load)"


def run(cmd, timeout=15, **kw):
    try:
        return sp.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)
    except Exception as e:
        return sp.CompletedProcess(cmd, 1, "", str(e))


RME_OFF = "no RME ADI-2: module off"


def rme_present():
    """RME module contract: RME rows are decided at run time by modules/rme-adi2/detect (next to this
    script in a checkout, else the installed kit copy). No module = off. Standby drops it off USB = absent."""
    here = os.path.dirname(os.path.realpath(__file__))
    data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    for d in (os.path.join(here, "modules", "rme-adi2", "detect"),
              os.path.join(data, "audio-doctor", "modules", "rme-adi2", "detect")):
        if os.access(d, os.X_OK):
            return run([d], timeout=5).returncode == 0
    return False


def rme_module_nodes():
    """node.names the rme-adi2 module's loopback config defines (rme_phones, ...), read from its template."""
    here = os.path.dirname(os.path.realpath(__file__))
    data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    for t in (os.path.join(here, "modules", "rme-adi2", "files", "50-rme-adi2-stereo.conf.in"),
              os.path.join(data, "audio-doctor", "modules", "rme-adi2", "files", "50-rme-adi2-stereo.conf.in")):
        try:
            names = set(re.findall(r'^\s*node\.name\s*=\s*"([^"]+)"', open(t).read(), re.M))
        except OSError:
            continue
        if names:
            return frozenset(names)
    return frozenset({"rme_phones", "rme_phones.out", "rme_in", "rme_in.cap"})


RME_NODES = rme_module_nodes()


def rme_chain(chain):
    """The default output chain is the ADI-2's: an ADI-2 ALSA node or one of the module's loopback nodes (named even
    when it no longer exists in the graph)."""
    return any("RME_ADI-2" in str(chain.get(k) or "") or chain.get(k) in RME_NODES
               for k in ("default_sink", "hardware_sink", "waits_for"))


def sweep_gate(chain, rme_on):
    """(sweep_block, note) for the hardware check. The default output waiting for an ADI-2 that is off USB (module
    off) is not a routing fault: the sweep is skipped with no extra note, the run's first line already said why."""
    # module off: the default output is the ADI-2 itself (a direct ALSA default, waits_for None, which the chain may
    # still name as hardware_sink) or a loopback waiting for it. Neutral skip, checked before the hardware sink.
    if not rme_on and rme_chain(chain):
        return "skipped (no hardware output now)", None
    if chain.get("hardware_sink"):
        return None, None
    return ("skipped: no hardware output behind the default sink",
            "No hardware output found behind the default sink (routing broken? run audio-doctor --fix): buffer sweep skipped.")


def rme_scrub(chain, rme_on):
    """Module off and the default output chain is the ADI-2's: the interface rows name no RME target (no hardware
    output now). Unchanged otherwise."""
    if rme_on or not rme_chain(chain):
        return chain
    return dict(chain, hardware_sink=None, card=None, waits_for=None, default_sink=None, description="no hardware output now")


def rd(path, default=""):
    try:
        return open(path).read().strip()
    except OSError:
        return default


# ====================================================================== root helper
# Started once through sudo; only MEASURES. Reads commands on stdin, answers on stdout.
def root_helper(outdir, rtla, user):
    T = "/sys/kernel/tracing"
    print("READY", flush=True)
    for line in sys.stdin:
        cmd = line.split()
        if not cmd:
            continue
        if cmd[0] == "quit":
            break
        if cmd[0] == "lspci":
            r = sp.run(["lspci", "-vvv"], capture_output=True, text=True, timeout=30)
            os.makedirs(os.path.join(outdir, "raw"), exist_ok=True)
            open(os.path.join(outdir, "raw", "lspci-vvv.txt"), "w").write(r.stdout)
            sp.run(["chown", "-R", f"{user}:{user}", outdir])
            print("DONE lspci", flush=True)
            continue
        if cmd[0] != "probe":
            continue
        phase, ct, tl = cmd[1], int(cmd[2]), int(cmd[3])
        d = os.path.join(outdir, "raw", phase)
        os.makedirs(d, exist_ok=True)
        log = []
        def step(name, argv, timeout, out):
            t0 = time.time()
            r = sp.run(argv, capture_output=True, text=True, timeout=timeout) if shutil.which(argv[0]) or os.path.exists(argv[0]) else None
            if r is None:
                log.append({"step": name, "skipped": f"{argv[0]} not installed"}); return
            open(os.path.join(d, out), "w").write(r.stdout + r.stderr)
            log.append({"step": name, "rc": r.returncode, "secs": round(time.time() - t0, 1)})
        try:
            step("turbostat", ["turbostat", "--quiet", "--interval", "5", "--num_iterations", "2", "--show",
                 "Core,CPU,Busy%,Bzy_MHz,CPU%c1,CPU%c6,CPU%c7,CoreTmp,PkgTmp,PkgWatt,IRQ"], 30, "turbostat.txt")
            for hold in ("nohold", "hold"):
                # --laptop = do NOT hold /dev/cpu_dma_latency (cyclictest holds it at 0 by default)
                argv = ["cyclictest", "-m", "-S", "-p", "80", "-i", "1000", "-D", str(ct), "-q"] + \
                       (["--laptop"] if hold == "nohold" else []) + \
                       ["-h", "3000", f"--histfile={d}/ct-{hold}.hist", f"--json={d}/ct-{hold}.json"]
                step(f"cyclictest {hold}", argv, ct + 20, f"ct-{hold}.txt")
            tracer = rd(f"{T}/current_tracer", "nop")
            if not rtla or not os.path.exists(rtla):
                log.append({"step": "timerlat", "skipped": "rtla not installed"})
            elif tracer != "nop":
                log.append({"step": "timerlat", "skipped": f"tracer busy ({tracer})"})
            else:
                for hold in ("nohold", "hold"):
                    argv = [rtla, "timerlat", "top", "-d", str(tl), "-q", "-P", "f:80", "--no-aa"] + (["--dma-latency", "0"] if hold == "hold" else [])
                    step(f"timerlat {hold}", argv, tl + 25, f"timerlat-{hold}.txt")
                try: open(f"{T}/current_tracer", "w").write("nop")
                except OSError: pass
        except Exception as e:
            log.append({"error": str(e)})
        json.dump(log, open(os.path.join(d, "root-steps.json"), "w"), indent=1)
        sp.run(["chown", "-R", f"{user}:{user}", outdir])
        print(f"DONE {phase}", flush=True)
    sp.run(["chown", "-R", f"{user}:{user}", outdir])


# ====================================================================== PipeWire helpers
def settings():
    out = run(["pw-metadata", "-n", "settings", "0"]).stdout
    return {m[1]: m[2] for m in re.finditer(r"key:'([^']+)' value:'([^']*)'", out)}


def setmeta(key, val):
    run(["pw-metadata", "-n", "settings", "0", key, str(val)])


def pw_dump():
    try:
        return json.loads(run(["pw-dump"]).stdout or "[]")
    except json.JSONDecodeError:
        return []


DAW_BINARIES = re.compile(r"bitwig|reaper|ardour|zrythm|carla|qtractor|renoise|lmms|bespoke|ableton|live\.exe|fl64\.exe|studio one|cubase", re.I)


def jack_clients(dump):
    """Clients a buffer-size change could break: every JACK client, plus DAWs on the native PipeWire
    backend (found 2026-11-17: Bitwig on its PipeWire backend is an Audio/Duplex node with no client.api,
    so a JACK-only check missed it)."""
    clients = {o["id"]: (o.get("info") or {}).get("props", {}) for o in dump if o.get("type", "").endswith("Client")}
    out = set()
    for o in dump:
        if not o.get("type", "").endswith("Node"): continue
        p = (o.get("info") or {}).get("props", {})
        cl = clients.get(p.get("client.id"), {})
        who = " ".join(str(x) for x in (p.get("node.name"), cl.get("application.name"), cl.get("application.process.binary")) if x)
        if p.get("client.api") == "jack" or DAW_BINARIES.search(who) or (p.get("media.class") == "Audio/Duplex" and cl):
            out.add(p.get("node.name") or cl.get("application.name") or "?")
    return sorted(out)


def interface_chain(dump):
    """default sink -> (through loopbacks) -> hardware sink; card id for matching its nodes."""
    nodes = {o["id"]: (o.get("info") or {}).get("props", {}) for o in dump if o.get("type", "").endswith("Node")}
    by_name = {p.get("node.name"): i for i, p in nodes.items()}
    links = [((o.get("info") or {}).get("output-node-id"), (o.get("info") or {}).get("input-node-id"))
             for o in dump if o.get("type", "").endswith("Link")]
    default = run(["pactl", "get-default-sink"]).stdout.strip()
    hw, cur, seen = None, default, set()
    for _ in range(4):
        if not cur or cur in seen: break
        seen.add(cur)
        if cur.startswith(("alsa_output", "bluez_output")):
            hw = cur; break
        nid = by_name.get(cur + ".out") or by_name.get(cur)
        nxt = [nodes[b].get("node.name") for a, b in links if a == nid and b in nodes]
        cur = nxt[0] if nxt else None
    card = None
    if hw:
        m = re.match(r"alsa_output\.(.+)\.[^.]+$", hw)
        card = m[1] if m else hw
    waits = (nodes.get(by_name.get(default + ".out")) or {}).get("target.object") if default else None
    return {"default_sink": default, "hardware_sink": hw, "card": card, "waits_for": waits,
            "description": next((p.get("node.description") for p in nodes.values() if p.get("node.name") == hw), hw)}


def pw_top():
    """{name: {state, quant, err, bq}} from the last pw-top batch frame (column offsets from the header)."""
    out = run(["pw-top", "-b", "-n", "3"], timeout=12).stdout.splitlines()
    rows, hdr = {}, None
    for line in out:
        if line.startswith("S ") and "NAME" in line:
            hdr = (line.index("FORMAT"), line.index("NAME")); continue
        if not hdr or len(line) < hdr[1]:
            continue
        head = line[:hdr[0]].split()
        if len(head) < 9 or not head[1].isdigit():
            continue
        name = line[hdr[1]:].strip().lstrip("+").strip()
        try:
            rows[name] = {"state": head[0], "quant": int(head[2]), "rate": int(head[3]), "bq": head[7], "err": int(head[8])}
        except ValueError:
            pass
    return rows


# ====================================================================== snapshot
def cpu_classes():
    core, atom = rd("/sys/devices/cpu_core/cpus"), rd("/sys/devices/cpu_atom/cpus")
    def expand(s):
        out = []
        for part in s.split(","):
            if "-" in part:
                a, b = part.split("-"); out += list(range(int(a), int(b) + 1))
            elif part.strip():
                out.append(int(part))
        return out
    if core and atom:
        return {"P": expand(core), "E": expand(atom)}
    return {"all": list(range(os.cpu_count() or 1))}


def pkg_temp():
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        if rd(f"{z}/type") == "x86_pkg_temp":
            v = rd(f"{z}/temp")
            return int(v) / 1000 if v.isdigit() else None
    r = run(["sensors", "-j"])
    try:
        for chip in json.loads(r.stdout).values():
            for k, v in chip.items():
                if k.startswith(("Package id", "Tctl")):
                    return next(x for kk, x in v.items() if kk.endswith("_input"))
    except Exception:
        pass
    return None


def throttle_ms():
    v = rd("/sys/devices/system/cpu/cpu0/thermal_throttle/package_throttle_total_time_ms")
    return int(v) if v.isdigit() else None


def context():
    top = run(["ps", "-eo", "pcpu,comm", "--sort=-pcpu", "--no-headers"]).stdout.splitlines()[:6]
    return {"time": time.strftime("%F %T"), "loadavg": rd("/proc/loadavg").split()[:3], "pkg_temp_c": pkg_temp(),
            "throttle_ms": throttle_ms(), "top_cpu": [l.strip() for l in top]}


def usb_audio_power():
    out = []
    for d in glob.glob("/sys/bus/usb/devices/*:*"):
        if rd(f"{d}/bInterfaceClass") != "01":
            continue
        dev = d.rsplit("/", 1)[0] + "/" + os.path.basename(d).split(":")[0]
        item = {"device": rd(f"{dev}/product", os.path.basename(dev)), "power_control": rd(f"{dev}/power/control"),
                "autosuspend_ms": rd(f"{dev}/power/autosuspend_delay_ms"), "speed_mbps": rd(f"{dev}/speed")}
        if item not in out:
            out.append(item)
    return out


# ====================================================================== power settings (read-only)
def _conf_values(patterns, keys):
    out = {}
    for pat in patterns:
        for f in sorted(glob.glob(pat)):
            for l in rd(f).splitlines():
                l = l.strip()
                if l.startswith("#") or "=" not in l: continue
                k, v = (x.strip() for x in l.split("=", 1))
                if k in keys: out[k] = v
    return out


def _usb_audio_devices():
    devs = []
    for d in glob.glob("/sys/bus/usb/devices/*:*"):
        if rd(f"{d}/bInterfaceClass") == "01":
            dev = os.path.realpath(d.rsplit("/", 1)[0] + "/" + os.path.basename(d).split(":")[0])
            if dev not in devs: devs.append(dev)
    return devs


def power_settings(dump, chain):
    """Every power-saving feature that can touch audio, current value + verdict (keep / session / measure / change).
    Windows lists say 'disable all power saving'; here each one is judged on what it is set to."""
    items = []
    def add(area, name, current, verdict, why):
        items.append({"area": area, "name": name, "current": str(current), "verdict": verdict, "why": why})
    # sleep / idle
    logind = _conf_values(["/usr/lib/systemd/logind.conf.d/*.conf", "/etc/systemd/logind.conf", "/etc/systemd/logind.conf.d/*.conf"],
                          ("IdleAction", "IdleActionSec", "HandlePowerKey", "HandleLidSwitch"))
    try: idle = json.load(open(os.path.expanduser("~/.config/omarchy/shell.json"))).get("idle", {})
    except Exception: idle = {}
    ia = logind.get("IdleAction", "ignore")
    auto = ia not in ("ignore", "lock") or any(k in ("suspend", "sleep", "hibernate") for k in idle)
    add("Sleep", "Automatic sleep", f"logind IdleAction={ia}; Omarchy idle {idle or 'defaults'}", "change" if auto else "keep",
        "Something suspends the machine when idle: an unattended take or render would stop." if auto else "Nothing suspends the machine on its own.")
    add("Sleep", "Hibernate", "configured (resume=)" if "resume=" in rd("/proc/cmdline") else "not configured", "keep", "Only when chosen by hand.")
    m = re.search(r"\[(\w+)\]", rd("/sys/power/mem_sleep"))
    add("Sleep", "Sleep type", m[1] if m else "?", "keep", "deep = real S3. After any sleep, USB devices re-plug: routing must relink (config-audit checks).")
    add("Idle", "Screensaver", f"after {idle.get('screensaver')} s" if idle.get("screensaver") else "Omarchy default (150 s)", "session",
        "The audio-reactive screensaver adds GPU/CPU load during an unattended take; pause it in session mode.")
    # USB, per audio interface
    add("USB", "USB autosuspend, global delay", rd("/sys/module/usbcore/parameters/autosuspend") + " s", "keep", "Applies only to devices set to 'auto'.")
    for dev in _usb_audio_devices():
        name = rd(f"{dev}/product", os.path.basename(dev)); ctl = rd(f"{dev}/power/control")
        add("USB", f"{name}: USB power", f"control={ctl}, status={rd(dev + '/power/runtime_status')}", "keep" if ctl == "on" else "change",
            "Never suspends." if ctl == "on" else "Can autosuspend: pin power/control=on with a udev rule.")
        hubs, p = [], os.path.dirname(dev)
        while re.match(r"^\d+-[\d.]+$", os.path.basename(p)):
            hubs.append(f"{rd(p + '/product', os.path.basename(p))} ({rd(p + '/power/control')})"); p = os.path.dirname(p)
        add("USB", f"{name}: hubs in between", ", ".join(hubs) or "none (straight into a root port)", "measure" if hubs else "keep",
            "Hubs add a hop and share bandwidth; a hub only sleeps when nothing below it is busy." if hubs else "Best case.")
        pcis = [x for x in dev.split("/") if re.match(r"^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.\d$", x)]
        if pcis:
            c = f"/sys/bus/pci/devices/{pcis[-1]}"
            add("PCI", f"{name}: its USB controller {pcis[-1]}", f"runtime PM {rd(c + '/power/control')}, {rd(c + '/power/runtime_status')}", "keep",
                "Cannot sleep while the interface is in use.")
    # CPU
    gov = sorted({rd(f) for f in glob.glob("/sys/devices/system/cpu/cpu*/cpufreq/scaling_governor")})
    epp = sorted({rd(f) for f in glob.glob("/sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference")})
    prof = run(["powerprofilesctl", "get"]).stdout.strip() if shutil.which("powerprofilesctl") else ""
    fast = "performance" in epp or prof == "performance" or "performance" in gov
    add("CPU", "Governor / EPP / power profile", f"driver {rd('/sys/devices/system/cpu/cpufreq/policy0/scaling_driver')}, governor {gov}, EPP {epp}, profile {prof or '?'}",
        "keep" if fast else "change", "Clocks up immediately." if fast else "Power-saving bias: clocks ramp slowly under bursty audio load. Use the performance profile.")
    nt = rd("/sys/devices/system/cpu/intel_pstate/no_turbo")
    add("CPU", "Turbo", "off" if nt == "1" else "on", "keep", "Heat, not turbo, is what limits a hot CPU; watch throttling in the context rows.")
    cs = [f"{rd(s + '/name')} {rd(s + '/latency')} µs{' (disabled)' if rd(s + '/disable') == '1' else ''}" for s in sorted(glob.glob("/sys/devices/system/cpu/cpu0/cpuidle/state*"))]
    add("CPU", "CPU sleep states (C-states)", ", ".join(cs) + f"; cmdline limits: {' '.join(re.findall(r'(?:intel_idle|processor)\.\S+|idle=\S+', rd('/proc/cmdline'))) or 'none'}", "session",
        "Hold them off (cpu_dma_latency=0) during sessions and compare with the latency probes; permanently off mostly adds heat.")
    # PCIe
    m = re.search(r"\[(\w+)\]", rd("/sys/module/pcie_aspm/parameters/policy"))
    add("PCI", "PCIe link power (ASPM) policy", m[1] if m else "?", "measure", "Per-link states are in the ASPM table (root). Suspect if rtla names a PCIe device.")
    ctl = [rd(f) for f in glob.glob("/sys/bus/pci/devices/*/power/control")]
    add("PCI", "PCI runtime power management", f"{ctl.count('auto')} devices auto, {ctl.count('on')} on", "keep", "Busy devices don't sleep; see the controller row above.")
    # GPU
    if os.path.exists("/proc/driver/nvidia/params"):
        dpm = re.search(r"DynamicPowerManagement: (\d+)", rd("/proc/driver/nvidia/params"))
        q = run(["nvidia-smi", "--query-gpu=pstate,persistence_mode,clocks.gr", "--format=csv,noheader"]).stdout.strip()
        add("GPU", "NVIDIA power management", f"DynamicPowerManagement={dpm[1] if dpm else '?'}; now {q}", "measure",
            "GPU power-state changes are a known latency spike. Test: latency probes while the GPU ramps, then with persistence + locked clocks.")
    # audio
    add("Audio", "Onboard HDA codec power save", f"{rd('/sys/module/snd_hda_intel/parameters/power_save', 'n/a')} s", "keep",
        "Pops after silence on onboard/HDMI audio only. Set 0 if that is the interface in use.")
    card = (chain or {}).get("card") or ""
    st = sorted({str((o.get("info") or {}).get("props", {}).get("session.suspend-timeout-seconds", "default 5"))
                 for o in dump if o.get("type", "").endswith("Node") and card and card in (o.get("info") or {}).get("props", {}).get("node.name", "")})
    if not st:
        add("Audio", "PipeWire suspend of the interface", "interface not found (routing broken?)", "measure", "Re-run after audio-doctor --fix.")
    else:
        add("Audio", "PipeWire suspend of the interface", ", ".join(st), "keep" if st == ["0"] else "change",
            "Never suspends." if st == ["0"] else "The interface sleeps when idle: pop / relock on the next sound. WirePlumber rule session.suspend-timeout-seconds = 0.")
    # disk
    for c in sorted(glob.glob("/sys/class/nvme/nvme*")):  # per controller: the live value, not the module default
        tol = rd(f"{c}/power/pm_qos_latency_tolerance_us")
        if not tol.isdigit(): continue
        capped = int(tol) <= 2000
        add("Disk", f"NVMe power states: {os.path.basename(c)} {rd(c + '/model').strip()[:22]}", f"wake latency allowed up to {int(tol) / 1000:g} ms",
            "keep" if capped else "measure",
            "Capped: no deep-sleep stall on the first read after quiet." if capped else
            "Deep power states allowed (~7 ms first read after quiet on these Sabrents). Cap it if this drive holds samples or plugin libraries.")
    add("Disk", "Write-back flushing", f"dirty {rd('/proc/sys/vm/dirty_background_bytes')}/{rd('/proc/sys/vm/dirty_bytes')} bytes, every {int(rd('/proc/sys/vm/dirty_writeback_centisecs', '0') or 0) / 100:g} s", "keep",
        "Bounded write bursts are good for recording.")
    # network
    for i in sorted(os.listdir("/sys/class/net")):
        if os.path.isdir(f"/sys/class/net/{i}/wireless"):
            up = rd(f"/sys/class/net/{i}/operstate") == "up"
            ps = run(["iw", "dev", i, "get", "power_save"]).stdout.strip() if shutil.which("iw") else "?"
            add("Network", f"Wi-Fi power save ({i})", f"{ps}, link {'up' if up else 'down'}", "measure" if up and "on" in ps else "keep",
                "Only matters if audio goes over Wi-Fi." if up else "Wi-Fi not in use.")
        elif re.match(r"^(en|eth)", i) and rd(f"/sys/class/net/{i}/operstate") == "up":
            eee = run(["ethtool", "--show-eee", i]).stdout if shutil.which("ethtool") else ""
            m = re.search(r"EEE status: (\w+)", eee)
            add("Network", f"Energy-Efficient Ethernet ({i})", m[1] if m else "unknown (ethtool not installed)", "measure",
                "Only matters for network audio (AES67/Dante/streaming).")
    if RME_ON and not shutil.which("adi2"):
        add("Device", "RME ADI-2 auto-standby", "adi2 not installed", "measure", "Install adi2 (adi2-control) to read and set it.")
    if RME_ON and shutil.which("adi2"):
        m = re.search(r"=\s*(\S+)", run(["adi2", "get", "device.auto_standby"]).stdout)
        st = m[1] if m else "?"
        add("Device", "RME ADI-2 auto-standby", st if st != "?" else "unreadable (a DAW holds its MIDI port?)", "keep" if st == "off" else ("measure" if st == "?" else "change"),
            "Never sleeps." if st == "off" else "After a quiet stretch the ADI-2 powers down and drops off USB: audio stops until its button is pressed, and PipeWire has to recover the device. Keep the timer so the unit sleeps when nobody is around; automated runs use studio-keepalive, a MIDI pulse that keeps it awake only while it runs.")
    add("Kernel", "NMI watchdog", "on" if rd("/proc/sys/kernel/nmi_watchdog") == "1" else "off", "measure", "Small periodic interrupt; realtime guides turn it off. A/B with the probes.")
    tuners = [t for t in ("tlp", "powertop", "auto-cpufreq", "laptop-mode", "thermald") if run(["systemctl", "is-enabled", f"{t}.service"]).stdout.strip() == "enabled"]
    add("Tools", "Power tuners (TLP, powertop auto-tune, auto-cpufreq...)", ", ".join(tuners) or "none enabled", "change" if tuners else "keep",
        "These turn USB autosuspend on for everything, the interface included." if tuners else "Good. Never run powertop --auto-tune on a studio box.")
    return items


def parse_aspm(path):
    """per-device PCIe link ASPM state from lspci -vvv (root)"""
    out, dev = [], None
    for l in rd(path).splitlines():
        if l and not l[0].isspace():
            dev = l.split(" ", 1)
        m = re.search(r"LnkCtl:\s+ASPM ([^;]+);", l)
        if m and dev:
            out.append({"device": dev[0], "name": dev[1][:70], "aspm": m[1].strip()})
    return out


def disk_wake(path, n=8, idle=2.0):
    """Cold-read latency: 4 KiB O_DIRECT reads after `idle` s of quiet (the NVMe may have dropped into a power state)
    vs back-to-back warm reads. Uses a 64 MiB probe file; no setting is changed."""
    import mmap, random
    f = os.path.join(path, "disk-wake-probe.bin")
    if not os.path.exists(f) or os.path.getsize(f) < 64 << 20:
        with open(f, "wb") as w:
            for _ in range(64): w.write(os.urandom(1 << 20))
            w.flush(); os.fsync(w.fileno())
    buf = mmap.mmap(-1, 4096)
    fd = os.open(f, os.O_RDONLY | os.O_DIRECT)
    def one():
        off = random.randrange(0, (64 << 20) // 4096) * 4096
        t = time.perf_counter(); os.preadv(fd, [buf], off); return (time.perf_counter() - t) * 1000
    try:
        warm = [one() for _ in range(n)]
        cold = []
        for _ in range(n):
            time.sleep(idle); cold.append(one())
    finally:
        os.close(fd)
    q = lambda xs: {"median_ms": round(sorted(xs)[len(xs) // 2], 3), "max_ms": round(max(xs), 3)}
    return {"path": path, "idle_s": idle, "reads": n, "warm": q(warm), "cold": q(cold)}


def snapshot(chain):
    classes = cpu_classes()
    gov = {c: sorted({rd(f"/sys/devices/system/cpu/cpu{i}/cpufreq/scaling_governor") for i in cpus}) for c, cpus in classes.items()}
    epp = {c: sorted({rd(f"/sys/devices/system/cpu/cpu{i}/cpufreq/energy_performance_preference") for i in cpus}) for c, cpus in classes.items()}
    return {"host": os.uname().nodename, "kernel": os.uname().release, "kernel_version": os.uname().version,
            "cmdline": rd("/proc/cmdline"), "cpu_model": next((l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name")), "?"),
            "cpu_classes": {c: f"{v[0]}-{v[-1]}" if v == list(range(v[0], v[-1] + 1)) else v for c, v in classes.items()},
            "governor": gov, "epp": epp, "threadirqs": "threadirqs" in rd("/proc/cmdline"),
            "rt_runtime_us": rd("/proc/sys/kernel/sched_rt_runtime_us"), "swappiness": rd("/proc/sys/vm/swappiness"),
            "pipewire_version": run(["pipewire", "--version"]).stdout.strip().splitlines()[-1:] or [""],
            "pipewire_settings": {k: v for k, v in settings().items() if k.startswith("clock.")},
            "interface": chain, "usb_audio_power": usb_audio_power(),
            "tools": {t: bool(shutil.which(t)) for t in ("cyclictest", "rtla", "turbostat", "stress-ng", "pw-top")}}


# ====================================================================== parsers
def parse_cyclictest(d, hold, classes):
    try:
        j = json.load(open(f"{d}/ct-{hold}.json"))
    except (OSError, json.JSONDecodeError):
        return None
    overflow = []
    m = re.search(r"# Histogram Overflows:(.*)", rd(f"{d}/ct-{hold}.hist"))
    if m:
        overflow = [int(x) for x in m[1].split()]
    out = {}
    for c, cpus in classes.items():
        mx, b100, b500, b1000 = 0, 0, 0, 0
        for t in j.get("thread", {}).values():
            if t.get("cpu") not in cpus: continue
            mx = max(mx, t.get("max", 0))
            for us, n in t.get("histogram", {}).items():
                us = int(us)
                b100 += n if us > 100 else 0; b500 += n if us > 500 else 0; b1000 += n if us > 1000 else 0
            ov = overflow[t["cpu"]] if t.get("cpu", 99999) < len(overflow) else 0
            b100 += ov; b500 += ov; b1000 += ov
        out[c] = {"max_us": mx, "over_100": b100, "over_500": b500, "over_1000": b1000}
    return out


def parse_timerlat(d, hold, classes):
    txt = rd(f"{d}/timerlat-{hold}.txt")
    if not txt:
        return None
    per = {}
    for line in txt.splitlines():
        m = re.match(r"^\s*(\d+)\s+#\d+\s*\|(.*)", line)
        if not m: continue
        cols = [c.split() for c in m[2].split("|")]
        try:
            per[int(m[1])] = {"irq_max": int(cols[0][3]), "thread_max": int(cols[1][3])}
        except (IndexError, ValueError):
            pass
    if not per:
        return None
    return {c: {"irq_max_us": max((per[i]["irq_max"] for i in cpus if i in per), default=None),
                "thread_max_us": max((per[i]["thread_max"] for i in cpus if i in per), default=None)} for c, cpus in classes.items()}


def parse_turbostat(d):
    lines = rd(f"{d}/turbostat.txt").splitlines()
    hdr = next((l.split("\t") for l in lines if l.startswith("Core")), None)
    rows = [l.split("\t") for l in lines if l.startswith("-\t")]
    if not hdr or not rows:
        return None
    return {k: v for k, v in zip(hdr, rows[-1]) if k in ("Busy%", "Bzy_MHz", "CPU%c6", "CPU%c7", "PkgTmp", "PkgWatt")}


# ====================================================================== sweep
def sweep(sizes, hold, card, rate, emit):
    res = []
    for q in sizes:
        setmeta("clock.force-quantum", q); time.sleep(3)
        a = pw_top(); time.sleep(hold); b = pw_top()
        iface = {n: r for n, r in b.items() if card and card in n and r["state"] == "R"}
        drv_q = max((r["quant"] for r in iface.values()), default=None)
        per = {n: r["err"] - a.get(n, {}).get("err", r["err"]) for n, r in b.items()}
        bad = {n: v for n, v in per.items() if v > 0}
        iface_x = sum(v for n, v in bad.items() if card and card in n)
        r = {"quantum": q, "block_ms": round(q / rate * 1000, 2), "seconds": hold, "interface_quant": drv_q,
             "valid": drv_q == q, "xruns": sum(bad.values()), "xruns_by_node": bad,
             "interface_xruns": iface_x, "client_xruns": sum(bad.values()) - iface_x,
             "interface_busy_over_quantum": max((x["bq"] for x in iface.values()), default=None)}
        res.append(r); emit(f"    quantum {q:5} ({r['block_ms']:5} ms): interface xruns {iface_x:3}, client xruns {r['client_xruns']:3}  driver ran at {drv_q}{'' if r['valid'] else '  INVALID'}")
    return res


def daw_phase(secs):
    a = pw_top(); time.sleep(secs); b = pw_top()
    per = {n: r["err"] - a.get(n, {}).get("err", r["err"]) for n, r in b.items()}
    return {"seconds": secs, "quantum": max((r["quant"] for r in b.values() if r["state"] == "R"), default=None),
            "xruns": sum(v for v in per.values() if v > 0), "xruns_by_node": {n: v for n, v in per.items() if v > 0}}


# ====================================================================== report
def watch_seed(phases):
    """Starting thresholds for omarchy-audio-watch (W11), from what this machine measured."""
    seed = {}
    for name, ph in phases.items():
        clean = [s["quantum"] for s in ph.get("sweep") or [] if s["valid"] and s["xruns"] == 0]
        iclean = [s["quantum"] for s in ph.get("sweep") or [] if s["valid"] and s.get("interface_xruns", s["xruns"]) == 0]
        worst = max((v["max_us"] for v in (ph.get("cyclictest", {}).get("nohold") or {}).values()), default=None)
        seed[name] = {"smallest_clean_quantum": min(clean) if clean else None,
                      "smallest_interface_clean_quantum": min(iclean) if iclean else None, "sched_worst_us": worst}
    return {"per_load": seed,
            "note": "Seeds, not rules: the watcher should alert on xruns at the session's quantum, and on scheduling latency or temperature beyond what this baseline measured."}


