# ====================================================================== main
def main():
    kind, tok = check_args(ARGS)
    if kind == "help":
        sys.stdout.write(USAGE); sys.exit(0)
    if kind == "bad":
        sys.stderr.write(f"omarchy-audio-audit: unknown argument: {tok}\n" + USAGE); sys.exit(2)
    if "--root-helper" in ARGS:
        return root_helper(opt("--root-helper"), opt("--rtla"), opt("--user"))
    t0 = time.time()
    global RME_ON
    RME_ON = rme_present()
    if not RME_ON: print(RME_OFF, flush=True)
    quick = "--quick" in ARGS
    ct_s, tl_s, hold_s = (15, 10, 10) if quick else (40, 30, 30)
    loads = (opt("--loads") or "idle,stress").split(",")
    daw = int(opt("--daw")) if opt("--daw") else None
    label = opt("--label") or ("first-run" if "--first-run" in ARGS else ("quick" if quick else ""))
    rid = time.strftime("%Y%m%d-%H%M") + (f"-{label}" if label else "")
    outdir = os.path.join(STATE, "first-run" if "--first-run" in ARGS else rid)
    if "--first-run" in ARGS and os.path.exists(os.path.join(outdir, "audit.json")):
        print(f"first-run audit already exists: {outdir}"); return
    os.makedirs(os.path.join(outdir, "raw"), exist_ok=True)
    notes = []
    def emit(m): print(m, flush=True)

    dump = pw_dump()
    chain = interface_chain(dump)
    sweep_block, note = sweep_gate(chain, RME_ON)  # before the scrub: it needs the ADI-2 names to see the module-off case
    chain = rme_scrub(chain, RME_ON)
    snap = snapshot(chain)
    snap["power"] = power_settings(dump, chain)
    orig = settings()
    rate = int(orig.get("clock.force-rate") or 0) or int(orig.get("clock.rate") or 48000)
    minq = int(orig.get("clock.min-quantum") or 32)
    sizes = [int(x) for x in (opt("--sizes") or "1024,256,128,64,32").split(",") if int(x) >= minq]
    jack = jack_clients(dump)
    emit(f"audio audit {rid}: interface {chain.get('description')} ({chain.get('hardware_sink')}), rate {rate}, loads {loads}")
    emit(f"  results: {outdir}")
    if note: notes.append(note)
    if jack and not daw:
        sweep_block = "skipped: DAW/JACK client(s) connected (" + ", ".join(jack) + "); a buffer change would kill a DAW engine. Quit the DAW, or use --daw."
    if daw and not jack:
        notes.append("--daw given but no DAW or JACK client is connected: DAW phase skipped. Start the DAW first (omarchy-studio-bitwig 128).")
        daw = None
    if daw:
        sweep_block = "skipped in DAW mode (sizes are never changed while a DAW is connected)"
    json.dump(json.loads(run(["audio-doctor", "--json"], timeout=30).stdout or "{}"), open(f"{outdir}/raw/audio-doctor-before.json", "w"), indent=1)
    ka = RME_ON and shutil.which("studio-keepalive") and not jack
    if ka:
        emit("  " + run(["studio-keepalive", "on"]).stdout.strip())

    # ---- state we own, restored on every exit path
    procs = {}
    restored = {"done": False}
    def restore():
        if restored["done"]: return
        restored["done"] = True
        fq, fr = orig.get("clock.force-quantum", "0"), orig.get("clock.force-rate", "0")
        if not sweep_block:
            if fq in ("0", ""):
                setmeta("clock.force-quantum", 1024); time.sleep(1)  # unstick the graph before releasing (M2 gotcha 1)
            setmeta("clock.force-quantum", fq or 0)
        setmeta("clock.force-rate", fr or 0)
        for name in ("stress", "silence"):
            p = procs.pop(name, None)
            if p and p.poll() is None:
                p.terminate()
                try: p.wait(5)
                except sp.TimeoutExpired: p.kill()
        h = procs.pop("helper", None)
        if h and h.poll() is None:
            try: h.stdin.write("quit\n"); h.stdin.flush(); h.wait(10)
            except Exception: h.kill()
    atexit.register(restore)
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: sys.exit(130))

    # ---- graph must RUN for a forced size to apply: our own silent stream to the default sink
    if chain.get("default_sink") and not sweep_block:
        procs["silence"] = sp.Popen(["pw-cat", "--playback", "--raw", "--format", "s16", "--rate", str(rate), "--channels", "2",
                                     "--target", chain["default_sink"], "-"], stdin=open("/dev/zero", "rb"), stdout=sp.DEVNULL, stderr=sp.DEVNULL)
        time.sleep(1)

    # ---- root helper: one approval, only measures
    helper = None
    if "--no-root" not in ARGS:
        rtla = shutil.which("rtla") or ""
        cmd = ["sudo", "-S", "-k", "-p", "", sys.executable, os.path.realpath(__file__), "--root-helper", outdir,
               "--rtla", rtla, "--user", os.environ.get("USER", "")]
        emit("  asking for sudo (one approval; ntfy push or keyring)...")
        helper = sp.Popen(cmd, stdin=sp.PIPE, stdout=sp.PIPE, stderr=sp.PIPE, text=True, bufsize=1)
        pw = ""
        if opt("--sudo") == "keyring":
            pw = run(["secret-tool", "lookup", "application", "codex", "purpose", "sudo", "account", os.environ.get("USER", "")]).stdout.strip()
        helper.stdin.write(pw + "\n"); helper.stdin.flush(); pw = None
        line = helper.stdout.readline()
        if line.strip() != "READY":
            notes.append("Root latency probes skipped: sudo was not approved (" + (helper.stderr.read()[:200].strip() if helper.poll() is not None else "no answer") + ").")
            helper.kill(); helper = None
        else:
            procs["helper"] = helper
            emit("  root helper ready")
            helper.stdin.write("lspci\n"); helper.stdin.flush()
            while True:
                l = helper.stdout.readline()
                if not l or l.startswith("DONE lspci"): break
            snap["aspm_links"] = parse_aspm(os.path.join(outdir, "raw", "lspci-vvv.txt"))
    else:
        notes.append("Root latency probes skipped (--no-root).")

    phases = {}
    try:
        for load in loads:
            ph = {"load_label": "the box as it is right now" if load == "idle" else STRESS_LABEL}
            emit(f"  [{load}]")
            if load == "stress":
                if not shutil.which("stress-ng"):
                    ph["skipped"] = "stress-ng not installed"; phases[load] = ph; continue
                procs["stress"] = sp.Popen(STRESS + ["--timeout", "1800"], stdout=sp.DEVNULL, stderr=sp.DEVNULL)
                time.sleep(10)
            ph["context_start"] = context()
            emit(f"    load {' '.join(ph['context_start']['loadavg'])}, package {ph['context_start']['pkg_temp_c']}°C")
            if helper:
                helper.stdin.write(f"probe {load} {ct_s} {tl_s}\n"); helper.stdin.flush()
                emit(f"    latency probes ({2 * ct_s + 2 * tl_s + 10} s)...")
                while True:
                    l = helper.stdout.readline()
                    if not l or l.startswith("DONE"): break
                d = os.path.join(outdir, "raw", load)
                ph["cyclictest"] = {h: parse_cyclictest(d, h, cpu_classes()) for h in ("nohold", "hold")}
                ph["timerlat"] = {h: parse_timerlat(d, h, cpu_classes()) for h in ("nohold", "hold")}
                ph["turbostat"] = parse_turbostat(d)
                for h in ("nohold", "hold"):
                    v = ph["cyclictest"].get(h)
                    if v: emit(f"    cyclictest {h}: " + ", ".join(f"{c} worst {x['max_us']} µs" for c, x in v.items()))
            if sweep_block:
                ph["sweep_skipped"] = sweep_block
                emit(f"    buffer sweep {sweep_block}")
            else:
                emit(f"    buffer sweep {sizes} ({hold_s} s each)...")
                ph["sweep"] = sweep(sizes, hold_s, chain.get("card"), rate, emit)
                setmeta("clock.force-quantum", orig.get("clock.force-quantum") or 1024); time.sleep(1)
            if daw:
                emit(f"    DAW phase ({daw} s at the current size)...")
                ph["daw"] = daw_phase(daw)
            ph["context_end"] = context()
            if load == "stress":
                p = procs.pop("stress", None)
                if p: p.terminate(); p.wait(10)
            phases[load] = ph
    finally:
        restore()

    if "--no-disk" not in ARGS:
        emit("  disk wake test (cold vs warm 4 KiB reads, ~20 s)...")
        try:
            snap["disk_wake"] = disk_wake(opt("--disk-path") or STATE)
            dw = snap["disk_wake"]
            emit(f"    warm median {dw['warm']['median_ms']} ms / max {dw['warm']['max_ms']} ms; after {dw['idle_s']:g} s idle: median {dw['cold']['median_ms']} ms / max {dw['cold']['max_ms']} ms")
        except OSError as e:
            snap["disk_wake"] = {"error": str(e)}
    pw = snap["power"]
    emit("  power settings: " + ", ".join(f"{sum(1 for i in pw if i['verdict'] == v)} {v}" for v in ("keep", "session", "measure", "change")))
    for i in pw:
        if i["verdict"] == "change": emit(f"    CHANGE: {i['name']}: {i['current']} ({i['why']})")

    if ka:
        emit("  " + run(["studio-keepalive", "off"]).stdout.strip())
    after = json.loads(run(["audio-doctor", "--json"], timeout=30).stdout or "{}")
    json.dump(after, open(f"{outdir}/raw/audio-doctor-after.json", "w"), indent=1)
    breaks = [f["message"] for f in after.get("findings", []) if f.get("severity") == "BREAK"]
    if breaks:
        notes.append("audio-doctor found a BREAK after the run: " + "; ".join(breaks))
    now = settings()
    if now.get("clock.force-quantum") != orig.get("clock.force-quantum") or now.get("clock.force-rate") != orig.get("clock.force-rate"):
        notes.append(f"PipeWire settings NOT restored: found {orig.get('clock.force-quantum')}/{orig.get('clock.force-rate')}, now {now.get('clock.force-quantum')}/{now.get('clock.force-rate')}")
    notes.append("Xruns are split: 'interface' = the audio device's own nodes missed a cycle; 'client' = a stream (here the audit's own test stream, an ordinary client) missed its deadline while the device kept time.")
    notes.append("The buffer sweep plays silence with no DSP load: it shows the interface wakes on time at each size, not that a full project will run there. The DAW phase covers that.")
    if "stress" in loads:
        notes.append("'stress' is a fixed synthetic recipe for comparable runs, not real agent load.")
    rep = {"id": rid, "took_min": round((time.time() - t0) / 60, 1), "args": ARGS, "snapshot": snap,
           "found_settings": {k: orig.get(k) for k in ("clock.force-quantum", "clock.force-rate", "clock.quantum", "clock.min-quantum")},
           "phases": phases, "notes": notes}
    rep["watch_seed"] = watch_seed(phases)
    json.dump(rep, open(f"{outdir}/audit.json", "w"), indent=1, default=str)
    render(rep, f"{outdir}/report.html")
    emit(f"done in {rep['took_min']} min: {outdir}/report.html")
    for n in notes: emit("  note: " + n)


if __name__ == "__main__":
    main()
