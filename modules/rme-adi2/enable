#!/bin/bash
# enable: put the RME pieces in place (WirePlumber pro-audio rule, PipeWire stereo loopbacks, studio-keepalive).
# Safe to run twice. Never overwrites a file it did not place: an identical one counts as present (not managed, disable
# leaves it), a different one is left as it is and makes enable exit 1.
# Records what it placed (with checksums) so disable removes exactly that. Exit 0 = every piece placed by this module;
# exit 1 = at least one piece is not (each such piece says why), and what could be placed is placed.
. "$(dirname "$(realpath "$0")")/lib.sh" || { echo "rme-adi2 enable: cannot read lib.sh"; exit 1; }
rc=0
# the manifest directory itself, recorded once it exists
mdirs=(); d=$(dirname "$MANIFEST"); while [ ! -d "$d" ]; do mdirs+=("$d"); d=$(dirname "$d"); done
mkdir -p "$(dirname "$MANIFEST")" || { echo "rme-adi2: cannot create $(dirname "$MANIFEST")"; exit 1; }
for d in "${mdirs[@]}"; do
  man_put "dir:$d" dir "$d" - && continue
  for x in "${mdirs[@]}"; do rmdir "$x" 2>/dev/null; done  # deepest first: undo what was created, place nothing
  echo "rme-adi2: cannot write $MANIFEST: nothing placed"; exit 1
done
while IFS='|' read -r name kind src dest; do
  if ours "$name"; then echo "$name: already placed by this module: $dest"; continue; fi
  if { [ -e "$dest" ] || [ -L "$dest" ]; } && [ -n "$(man_get "$name")" ]; then
    echo "$name: NOT placed: $dest changed since enable placed it: left as it is"; rc=1; continue
  fi
  want=$(render "$kind" "$src") || {
    echo "$name: NOT placed: cannot resolve the unit's ALSA node names from udev ID_SERIAL or the PipeWire graph (device off USB?); nothing half-filled written; run enable again with the RME awake"
    rc=1; continue; }
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    if identical "$kind" "$dest" "$want"; then
      echo "$name: already present, identical, not managed: $dest (disable leaves it)"
    else
      echo "$name: NOT placed: $dest already exists with different content and was not placed by this module: left as it is"; rc=1
    fi
    continue
  fi
  mkd "$(dirname "$dest")" || { echo "$name: NOT placed: cannot create or record $(dirname "$dest")"; rc=1; continue; }
  # record first, then place: a piece on disk is always in the manifest, so disable can always remove it.
  # If placing fails the record is dropped again; if even that fails, disable later finds the dest gone.
  if [ "$kind" = link ]; then
    man_put "$name" "$kind" "$dest" "$want" || { echo "$name: NOT placed: cannot write $MANIFEST"; rc=1; continue; }
    if ln -s "$want" "$dest"; then echo "$name: placed $dest -> $want"
    else echo "$name: NOT placed: link failed"; man_del "$name"; rc=1; fi
  else
    tmp="$dest.rme-adi2.tmp"
    if ! printf '%s\n' "$want" >"$tmp"; then echo "$name: NOT placed: write failed"; rm -f "$tmp"; rc=1; continue; fi
    man_put "$name" "$kind" "$dest" "$(sum_of "$tmp")" || { echo "$name: NOT placed: cannot write $MANIFEST"; rm -f "$tmp"; rc=1; continue; }
    if mv -f "$tmp" "$dest"; then echo "$name: placed $dest"
    else echo "$name: NOT placed: write failed"; rm -f "$tmp"; man_del "$name"; rc=1; fi
  fi
done < <(pieces)
adi2_line
echo "$RESTART_NOTE"
exit $rc
